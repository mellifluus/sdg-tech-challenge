          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 16,
      "title": "Executor slots",
      "description": "LocalExecutor parallelism",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
