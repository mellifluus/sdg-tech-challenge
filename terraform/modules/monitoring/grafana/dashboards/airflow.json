                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(clamp_min(airflow_dagrun_duration_failed_count{dag_id=~\"$dag_id\"} - (airflow_dagrun_duration_failed_count{dag_id=~\"$dag_id\"} offset $__range or airflow_dagrun_duration_failed_count{dag_id=~\"$dag_id\"} * 0), 0)) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "id": 8,
      "title": "DAG runs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "DAG runs finished",
      "description": "DAG runs completed per interval, by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (dag_id) (clamp_min(airflow_dagrun_duration_success_count{dag_id=~\"$dag_id\"} - (airflow_dagrun_duration_success_count{dag_id=~\"$dag_id\"} offset $__interval or airflow_dagrun_duration_success_count{dag_id=~\"$dag_id\"} * 0), 0))",
          "legendFormat": "{{dag_id}} success",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (dag_id) (clamp_min(airflow_dagrun_duration_failed_count{dag_id=~\"$dag_id\"} - (airflow_dagrun_duration_failed_count{dag_id=~\"$dag_id\"} offset $__interval or airflow_dagrun_duration_failed_count{dag_id=~\"$dag_id\"} * 0), 0))",
          "legendFormat": "{{dag_id}} failed",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "DAG run duration p95",
      "description": "Approximate: StatsD histogram buckets go from 0.5s to 1h",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, dag_id) (rate(airflow_dagrun_duration_success_bucket{dag_id=~\"$dag_id\"}[$__rate_interval])))",
          "legendFormat": "{{dag_id}} success",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, dag_id) (rate(airflow_dagrun_duration_failed_bucket{dag_id=~\"$dag_id\"}[$__rate_interval])))",
          "legendFormat": "{{dag_id}} failed",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Running DAG runs",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
